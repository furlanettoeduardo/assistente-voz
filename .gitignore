# Configurações reais (têm chaves e tokens), inclusive cópias e backups.
# Versione só os *.example.json.
config_agente*.json*
config_servidor*.json*
!config_agente.example.json
!config_servidor.example.json
.env
.env.*
!.env.example

# Arquivos que o "python -m tinytuya wizard" grava na pasta onde roda: têm a chave da API da Tuya
# e a local key da lâmpada.
tinytuya.json
devices.json
tuya-raw.json
snapshot.json

# Token do Spotify que o spotify_conectar.py grava: dá acesso à sua conta.
spotify_token*.json*
.spotify_token-*.tmp

# Vozes do Piper baixadas (60 MB cada)
vozes/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log
logs/

# Arquivos de sistema
.DS_Store
Thumbs.db
desktop.ini
